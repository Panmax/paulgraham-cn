---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ArticleBody from "../components/ArticleBody.astro";
import TagChips from "../components/TagChips.astro";
import { sortArticles } from "../lib/sort.js";
import { withNeighbors } from "../lib/adjacent.js";
import { tagsFor } from "../lib/tags.js";
import { tagById } from "../../shared/tags.js";
import { articleDescription } from "../lib/excerpt.js";
import { summaryFor } from "../lib/summaries.js";

export async function getStaticPaths() {
  const entries = await getCollection("articles");
  const translatedSlugs = entries.map((entry) => entry.data.slug);
  const sorted = sortArticles(entries.map((e) => e.data));
  // Shared-tag neighbours: the tag pages already group articles, but a reader
  // finishing one essay needs a path to the next one without going back to the
  // index. Top 5 by shared tags, newest first on ties.
  const relatedBySlug = new Map<string, typeof sorted>();
  for (const article of sorted) {
    const own = new Set(tagsFor(article.slug));
    relatedBySlug.set(article.slug, sorted
      .filter((other) => other.slug !== article.slug)
      .map((other) => ({ other, shared: tagsFor(other.slug).filter((t) => own.has(t)).length }))
      .filter(({ shared }) => shared > 0)
      .sort((a, b) => b.shared - a.shared
        || (b.other.publishedAt ?? "").localeCompare(a.other.publishedAt ?? ""))
      .slice(0, 5)
      .map(({ other }) => other));
  }
  return withNeighbors(sorted).map(({ article, prev, next }) => ({
    params: { slug: article.slug },
    props: { article, prev, next, translatedSlugs, related: relatedBySlug.get(article.slug) ?? [] },
  }));
}
const { article, prev, next, translatedSlugs, related } = Astro.props;
const canonical = `https://paulgraham-cn.com/${article.slug}`;
const summary = summaryFor(article.slug);
const description = summary ?? articleDescription(article);
const firstTag = tagById(tagsFor(article.slug)[0] ?? "");
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "首页", item: "https://paulgraham-cn.com/" },
  ...(firstTag
    ? [{ "@type": "ListItem", position: 2, name: firstTag.zh, item: `https://paulgraham-cn.com/tag/${firstTag.id}` }]
    : []),
  { "@type": "ListItem", position: firstTag ? 3 : 2, name: article.titleZh },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: article.titleZh,
      alternativeHeadline: article.titleEn,
      inLanguage: "zh-CN",
      mainEntityOfPage: canonical,
      url: canonical,
      description,
      author: {
        "@type": "Person",
        name: "Paul Graham",
        url: "https://paulgraham.com/",
        sameAs: "https://en.wikipedia.org/wiki/Paul_Graham_(programmer)",
      },
      translator: {
        "@type": "Organization",
        name: "Paul Graham 中文",
        url: "https://paulgraham-cn.com/",
      },
      publisher: {
        "@type": "Organization",
        name: "Paul Graham 中文",
        url: "https://paulgraham-cn.com/",
        logo: {
          "@type": "ImageObject",
          url: "https://paulgraham-cn.com/apple-touch-icon.png",
          width: 180,
          height: 180,
        },
      },
      ...(article.publishedAt ? { datePublished: article.publishedAt } : {}),
      dateModified: article.translatedAt,
      translationOfWork: {
        "@type": "Article",
        name: article.titleEn,
        url: article.sourceUrl,
        inLanguage: "en",
      },
      keywords: tagsFor(article.slug).map((id) => tagById(id)?.zh).filter(Boolean),
    },
    { "@type": "BreadcrumbList", itemListElement: breadcrumbItems },
  ],
};
---
<Base
  title={article.titleZh}
  description={description}
  canonical={canonical}
  type="article"
  jsonLd={jsonLd}
  publishedTime={article.publishedAt ?? undefined}
  modifiedTime={article.translatedAt}
>
  <main class="article">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a>
      {firstTag && (
        <><span aria-hidden="true">›</span><a href={`/tag/${firstTag.id}`}>{firstTag.zh}</a></>
      )}
      <span aria-hidden="true">›</span><span>{article.titleZh}</span>
    </nav>
    <p class="kicker">
      {article.publishedAt ? (
        <><time datetime={article.publishedAt}>{article.dateText}</time> ·{" "}</>
      ) : article.dateText ? (
        <>{article.dateText} ·{" "}</>
      ) : null}
      Paul Graham
    </p>
    <h1 class="article-title">{article.titleZh}</h1>
    <p class="article-title-en" lang="en">{article.titleEn}</p>
    {summary && <p class="article-summary">{summary}</p>}
    <hr class="title-rule" />
    <div class="article-tags"><TagChips ids={tagsFor(article.slug)} /></div>
    <div class="article-meta">
      <a href={article.sourceUrl}>英文原文</a>
      <button id="read-toggle" aria-pressed="false">双语对照</button>
    </div>
    <ArticleBody segments={article.segments} translatedSlugs={translatedSlugs} />
    {related.length > 0 && (
      <section class="related">
        <h2>相关文章</h2>
        <ul>
          {related.map((item) => (
            <li>
              <a href={`/${item.slug}`}>{item.titleZh}</a>
              <span class="related-en" lang="en">{item.titleEn}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
    <nav class="article-nav">
      <a href="/">← 返回目录</a>
      <span>
        {prev && <a href={`/${prev.slug}`}>← {prev.titleZh}</a>}
        {next && <a href={`/${next.slug}`}>{next.titleZh} →</a>}
      </span>
    </nav>
    <section class="cite">
      <h2>引用本文</h2>
      <p>
        Paul Graham, “{article.titleEn}”{article.dateText && <>, {article.dateText}</>},
        {" "}<a href={article.sourceUrl}>{article.sourceUrl}</a>.<br />
        中文译文：<a href={canonical}>{canonical}</a>
      </p>
    </section>
  </main>
  <script is:inline>
    (() => {
      let saved = null;
      try { saved = localStorage.getItem("read"); } catch { /* storage blocked */ }
      if (saved === "bilingual") document.body.dataset.read = "bilingual";
      const btn = document.getElementById("read-toggle");
      const sync = () => { if (!btn) return;
        const on = document.body.dataset.read === "bilingual";
        btn.setAttribute("aria-pressed", String(on)); };
      if (btn) sync();
      btn?.addEventListener("click", () => {
        const on = document.body.dataset.read === "bilingual";
        document.body.dataset.read = on ? "zh" : "bilingual";
        try { localStorage.setItem("read", on ? "zh" : "bilingual"); } catch { /* storage blocked */ }
        sync();
      });
    })();
  </script>
</Base>
